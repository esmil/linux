/ {
	cpus: cpus {
			#address-cells = <1>;
			#size-cells = <0>;
			timebase-frequency = <24000000>;

			cpu_0: cpu@0 {
				device_type = "cpu";
				reg = <0>;
				model = "Spacemit(R) X100";
				status = "okay";
				compatible = "riscv";
				riscv,isa = "rv64imafdcvh";
