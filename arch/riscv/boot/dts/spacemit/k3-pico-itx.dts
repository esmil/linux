&pwm18 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm18_2_cfg>;
	status = "okay";
};

&dpu0_crtc0 {
	memory-region = <&dpu_resv0>;
	status = "okay";
};

&edp0 {
	pinctrl-names = "default";
	pinctrl-0 = <&dp0_1_cfg>;
	backlight = <&backlight>;
	gpios-power = <101>;
	gpios-enable = <118>;
	status = "okay";
};

&dpu1_crtc0 {
	memory-region = <&dpu_resv1>;
	status = "okay";
};

&dp1 {
	pinctrl-names = "default";
	pinctrl-0 = <&dp1_1_cfg>;
	status = "okay";
};

&adma3 {
	status = "okay";
};

&ri2s3 {
	status = "okay";
};

&sound_card_dp1 {
	status = "okay";
	simple-audio-card,name = "snd-dp1";
	simple-audio-card,mclk-fs = <512>;
	simple-audio-card,dai-link@0 {
		format = "left_j";
		frame-master = <&dp1_link_cpu>;
		bitclock-master = <&dp1_link_cpu>;
		dp1_link_codec: codec {
			playback-only;
			sound-dai = <&dp1>;
		};
	};
};

&i2s1 {
	status = "okay";
	pinctrl-0 = <&sspa1_1_cfg>;
	pinctrl-names = "default";
};

&sound_card1 {
	status = "okay";
	simple-audio-card,name = "snd-es8326";
	simple-audio-card,mclk-fs = <256>;
	simple-audio-card,dai-link@0 {
		format = "i2s";
		frame-master = <&link1_cpu>;
		bitclock-master = <&link1_cpu>;

		link1_cpu: cpu {
			sound-dai = <&i2s1>;
		};

		link1_codec: codec {
			sound-dai = <&es8326>;
		};
	};
};

&cpu_0 {
	clst-supply = <&adcdc1>;
};

&cpu_1 {
	clst-supply = <&adcdc1>;
};

&cpu_2 {
	clst-supply = <&adcdc1>;
};

&cpu_3 {
	clst-supply = <&adcdc1>;
};

&cpu_4 {
	clst-supply = <&adcdc1>;
};

&cpu_5 {
	clst-supply = <&adcdc1>;
};

&cpu_6 {
	clst-supply = <&adcdc1>;
};

&cpu_7 {
	clst-supply = <&adcdc1>;
};
