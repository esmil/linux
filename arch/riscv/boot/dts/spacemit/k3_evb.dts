&dpu_crtc0 {
	memory-region = <&dpu_resv0>;
	status = "disabled";
};

&dpu_crtc1 {
	memory-region = <&dpu_resv1>;
	status = "disabled";
};

&dsi0 {
	status = "disabled";

	panel0: panel0@0 {
		status = "ok";
		compatible = "spacemit,mipi-panel";
		reg = <0>;
		reset-gpios = <&gpio 1 31 GPIO_ACTIVE_HIGH>;
		bl-gpios = <&gpio 1 29 GPIO_ACTIVE_HIGH>;
		dc0-gpios = <&gpio 1 24 GPIO_ACTIVE_HIGH>;
		dc1-gpios = <&gpio 1 25 GPIO_ACTIVE_HIGH>;
		id = <2>;
		force-attached = "lcd_icnl9911c_mipi";
	};
};

&lcds {
	status = "disabled";
};

&dpu0_crtc0 {
	memory-region = <&dpu_resv0>;
	status = "okay";
};

&dp0 {
	pinctrl-names = "default";
	pinctrl-0 = <&dp0_2_cfg>;
	status = "okay";
};

&dpu1_crtc0 {
	memory-region = <&dpu_resv1>;
	status = "okay";
};

&dp1 {
	pinctrl-names = "default";
	pinctrl-0 = <&dp1_4_cfg>;
	status = "okay";
};

&adma2 {
	status = "okay";
};

&ri2s2 {
	status = "okay";
};

&sound_card_dp0 {
	status = "okay";
	simple-audio-card,name = "snd-dp0";
	simple-audio-card,mclk-fs = <512>;
	simple-audio-card,dai-link@0 {
		format = "left_j";
		frame-master = <&dp0_link_cpu>;
		bitclock-master = <&dp0_link_cpu>;
		dp0_link_codec: codec {
			playback-only;
			sound-dai = <&dp0>;
		};
	};
};

&ccic0 {
	status = "okay";
};

&ccic1 {
	status = "okay";
};

&ccic2 {
	status = "okay";
};

&ccic3 {
	status = "okay";
};

&csiphy0 {
	status = "okay";
};

&csiphy1 {
	status = "okay";
};

&csiphy2 {
	status = "okay";
};
