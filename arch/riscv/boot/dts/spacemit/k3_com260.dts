#include "k3.dtsi"
#include "k3-rdomain.dtsi"
#include "k3-pinctrl.dtsi"
#include "k3_opp_table.dtsi"
#include "k3-dp1.dtsi"

/ {
	compatible = "spacemit,k3-com260";
	cpus: cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <24000000>;
	};
/*
	p12v: p12v {
		compatible = "regulator-fixed";
		regulator-name = "p12v";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
		status = "disabled";
	};

	p5v: p5v {
		compatible = "regulator-fixed";
		regulator-name = "p5v";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&p12v>;
		status = "disabled";
	};

	p1v8: p1v8 {
		compatible = "regulator-fixed";
		regulator-name = "p1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&p5v>;
		status = "disabled";
	};

	p3v3: p3v3 {
		compatible = "regulator-fixed";
		regulator-name = "p3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&p5v>;
		status = "disabled";
	};
*/
	chosen {
		bootargs = "earlycon=sbi console=ttyS0,115200 clk_ignore_unused nohlt loglevel=8 random.trust_bootloader=1";
		rng-seed = <0x25d69b2 0xff555073 0xd23238ea 0x57aa5455 0x792478ed 0xa744f28e 0x6ba4fc54 0xa2bf20fc>;
		stdout-path = "serial0:115200";
	};

	rfkill-pcie-wlan {
		compatible = "rfkill-gpio";
		label = "rfkill-pcie-wlan";
		pinctrl-names = "default";
		pinctrl-0 = <&m2_wdis1_cfg>;
		radio-type = "wlan";
		shutdown-gpios = <&gpio 2 9 GPIO_ACTIVE_LOW>;
	};

	rfkill-m2-bt {
		compatible = "rfkill-gpio";
		label = "rfkill-m2-bt";
		pinctrl-names = "default";
		pinctrl-0 = <&m2_wdis2_cfg>;
		radio-type = "bluetooth";
		shutdown-gpios = <&gpio 1 25 GPIO_ACTIVE_LOW>;
	};
};

&resmem {
	/* global autoconfigured region for contiguous allocations */
	cmamem: linux,cma {
		compatible = "shared-dma-pool";
		reusable;
		size = <0 0x20000000>;
		alloc-ranges = <1 0x40000000 0 0x20000000>;
		linux,cma-default;
	};
};

&pinctrl {
	can2-1-cfg {
		can2-0-pins {
			power-source = <3300>;
		};
	};

	gmac1-cfg {
		/delete-node/ gmac1-2-pins;
		/delete-node/ gmac1-4-pins;
		/delete-node/ gmac1-5-pins;

		gmac1-0-pins {
			power-source = <1800>;
		};

		gmac1-1-pins {
			power-source = <1800>;
		};

		gmac1-3-pins {
			power-source = <1800>;
		};

		gmac1-6-pins {
			pinmux = <K3_PADCONF(37, 0)>;

			bias-disable;
			drive-strength = <25>;
			power-source = <1800>;
		};
	};

	i2c0-0-cfg {
		i2c0-0-pins {
			power-source = <3300>;
		};
	};

	i2c1-1-cfg {
		i2c1-0-pins {
			power-source = <1800>;
		};
	};

	i2c6-1-cfg {
		i2c6-0-pins {
			power-source = <3300>;
		};
	};

	fusb301_cfg: fusb301-cfg {
		fusb301-0-pins {
			pinmux = <K3_PADCONF(58, 0)>;

			bias-pull-up;
			drive-strength = <25>;
			power-source = <1800>;
		};
	};

	dp1_3_cfg: dp1-3-cfg {
		dp1-0-pins {
			pinmux = <K3_PADCONF(72, 4)>;	/* dp1 hpd */

			bias-disable;			/* normal bias disable */
			drive-strength = <25>;		/* DS8 */
			power-source = <3300>;
		};
	};

	pcie0_1_cfg: pcie0-1-cfg {
		pcie0-0-pins {
			pinmux = <K3_PADCONF(79, 5)>,	/* pcie0 perst */
				<K3_PADCONF(81, 5)>;	/* pcie0 clkreq */

			bias-pull-up;			/* normal bias disable */
			drive-strength = <38>;		/* DS8 */
			power-source = <3300>;
		};
	};

	pcie4_0_cfg: pcie4-0-cfg {
		pcie4-0-pins {
			pinmux = <K3_PADCONF(76, 5)>,	/* pcie4 perst */
				<K3_PADCONF(80, 5)>,	/* pcie4 wake */
				<K3_PADCONF(78, 5)>;	/* pcie4 clkreq */

			bias-pull-up;			/* normal bias disable */
			drive-strength = <38>;		/* DS8 */
			power-source = <3300>;
		};
	};

	m2_wdis1_cfg: m2-wdis1-cfg {
		m2-wdis1-pins {
			pinmux = <K3_PADCONF(73, 0)>;

			bias-pull-up;
			drive-strength = <38>;
			power-source = <3300>;
		};
	};

	m2_wdis2_cfg: m2-wdis2-cfg {
		m2-wdis2-pins {
			pinmux = <K3_PADCONF(57, 0)>;

			bias-pull-up;
			drive-strength = <38>;
			power-source = <3300>;
		};
	};

	qspi-cfg {
		/delete-node/ qspi-1-pins;
		qspi-0-pins {
			power-source = <1800>;
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_0_cfg>;
	status = "okay";
};

&qspi {
	pinctrl-names = "default";
	pinctrl-0 = <&qspi_cfg>;
	spacemit,qspi-tx-dma = <0>;
	spacemit,qspi-rx-dma = <0>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <26500000>;
		m25p,fast-read;
		broken-flash-reset;
		status = "okay";
	};
};

&sdcard {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc1_cfg>;
	bus-width = <4>;
	wp-inverted;
	cd-gpios = <&gpio 0 4 GPIO_ACTIVE_HIGH>;
	vmmc-supply = <&p3v3>;
	vqmmc-supply = <&aldo1>;
	no-mmc;
	no-sdio;
	clock-frequency = <204800000>;
	spacemit,tx_delaycode = <0x1f>;
	status = "okay";
};

&usb2_host_u2phy {
	status = "disabled";
};

&usb2_host {
	status = "disabled";
};

&usb3_porta_u2phy {
	status = "okay";
};

&usb3_porta_u3phy {
	orientation-switch;
	status = "okay";

	port {
		usb3_phy_switch: endpoint {
			remote-endpoint = <&fusb301_sw_ep>;
		};
	};
};

&usb3_porta {
	dr_mode = "otg";
	usb-role-switch;
	role-switch-default-mode = "peripheral";
	monitor-vbus;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0x0>;
			porta_role_switch: endpoint {
				remote-endpoint = <&fusb301_ep>;
			};
		};
	};
};

&usb3_portb_u2phy {
	status = "okay";
};

&usb3_portb_u3phy {
	status = "okay";
};

&usb3_portb {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* VL817 USB2.0 hub (4 ports) */
	hub_2_0: hub@1 {
		compatible = "usb2109,2817";
		reg = <1>;
		peer-hub = <&hub_3_0>;
		/* GPIO53(MIPI_CSI3_PWDN) for HUB 3V3 RST */
		reset-gpio = <&gpio 1 21 GPIO_ACTIVE_LOW>;
	};

	/* VL817 USB3.0 hub (4 ports) */
	hub_3_0: hub@2 {
		compatible = "usb2109,817";
		reg = <2>;
		peer-hub = <&hub_2_0>;
		/* GPIO53(MIPI_CSI3_PWDN) for HUB 3V3 RST */
		reset-gpio = <&gpio 1 21 GPIO_ACTIVE_LOW>;
	};
};

&ufshc {
	status = "okay";
};

&pcie0_rc {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_1_cfg>;

	max-link-speed = <1>;
	num-lanes = <4>;
	status = "okay";
};

&pcie4_rc {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie4_0_cfg>;

	max-link-speed = <1>;
	status = "okay";
};

&eth1 {
	pinctrl-names = "default";
	pinctrl-0 = <&gmac1_cfg>;

	max-speed = <1000>;
	tx-fifo-depth = <8192>;
	rx-fifo-depth = <8192>;
	snps,tso;
	snps,force_sf_dma_mode;
	phy-mode = "rgmii";
	phy-handle = <&rgmii1>;
	snps,reset-gpios = <&gpio 1 5 GPIO_ACTIVE_LOW>;
	snps,reset-delays-us = <2 10000 10000>;

	spacemit,wake-irq-enable;

	spacemit,clk-tuning-enable;
	spacemit,clk-tuning-by-delayline;
	spacemit,tx-phase = <47>;
	spacemit,rx-phase = <53>;

	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "snps,dwmac-mdio";

		rgmii1: phy@1 {
			compatible = "ethernet-phy-id001c.c916";
			reg = <0x1>;
			device_type = "ethernet-phy";
		};
	};
};

&rpmi_regulator {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c8_cfg_rcpu>;

	pvin: pvin {
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
		regulator-boot-on;
	};

	edcdc2: edcdc2 {
		regulator-min-microvolt = <800000>;
		regulator-max-microvolt = <800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	edcdc1: edcdc1 {
		regulator-min-microvolt = <534000>;
		regulator-max-microvolt = <1000000>;
		regulator-always-on;
		regulator-boot-on;
	};

	p3v3: p3v3 {
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	p1v8: p1v8 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	dcdc1: dcdc1 {
		regulator-min-microvolt = <1050000>;
		regulator-max-microvolt = <1050000>;
		regulator-always-on;
		regulator-boot-on;
	};

	dcdc3: dcdc3 {
		regulator-min-microvolt = <800000>;
		regulator-max-microvolt = <800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	dcdc4: dcdc4 {
		regulator-min-microvolt = <2100000>;
		regulator-max-microvolt = <2100000>;
		regulator-always-on;
		regulator-boot-on;
	};

	dcdc5: dcdc5 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	dcdc6: dcdc6 {
		regulator-min-microvolt = <500000>;
		regulator-max-microvolt = <600000>;
		regulator-always-on;
		regulator-boot-on;
	};

	aldo1: aldo1 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	aldo2: aldo2 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	aldo3: aldo3 {
		regulator-min-microvolt = <500000>;
		regulator-max-microvolt = <3400000>;
	};

	aldo4: aldo4 {
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	dldo1: dldo1 {
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-always-on;
		regulator-boot-on;
	};

	dldo2: dldo2 {
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		regulator-always-on;
		regulator-boot-on;
	};

	dldo3: dldo3 {
		regulator-min-microvolt = <800000>;
		regulator-max-microvolt = <800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	dldo4: dldo4 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	dldo5: dldo5 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	dldo6: dldo6 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	dldo7: dldo7 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	pwr_x100: pwr_x100 {
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	pwr_a100: pwr_a100 {
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	pwr_ext: pwr_ext {
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};
};

&thermal_zones {
	thermal_0 {
		polling-delay = <1000>;
		polling-delay-passive = <250>;
		thermal-sensors = <&thermal 0>;

		trips {
			thermal0_trip0: thermal0-trip0 {
				temperature = <40000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};
	};

	thermal_1 {
		polling-delay = <1000>;
		polling-delay-passive = <250>;
		thermal-sensors = <&thermal 1>;

		trips {
			thermal1_trip0: thermal1-trip0 {
				temperature = <40000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};
	};

	thermal_2 {
		polling-delay = <1000>;
		polling-delay-passive = <250>;
		thermal-sensors = <&thermal 2>;

		trips {
			thermal2_trip0: thermal2-trip0 {
				temperature = <40000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};
	};

	thermal_3 {
		polling-delay = <1000>;
		polling-delay-passive = <250>;
		thermal-sensors = <&thermal 3>;

		trips {
			thermal3_trip0: thermal3-trip0 {
				temperature = <40000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};
	};

	thermal_4 {
		/* top sensor */
		polling-delay = <1000>;
		polling-delay-passive = <250>;
		thermal-sensors = <&thermal 4>;

		trips {
			thermal4_top_trip0: thermal4-trip0 {
				temperature = <35000>;
				hysteresis = <5000>;
				type = "active";
			};

			thermal4_top_trip1: thermal4-trip1 {
				temperature = <40000>;
				hysteresis = <5000>;
				type = "passive";
			};

			thermal4_top_trip2: thermal4-trip2 {
				temperature = <50000>;
				hysteresis = <5000>;
				type = "passive";
			};

			thermal4_top_trip3: thermal4-trip3 {
				temperature = <60000>;
				hysteresis = <5000>;
				type = "passive";
			};

			thermal4_top_trip4: thermal4-trip04 {
				temperature = <70000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			map0 {
				trip = <&thermal4_top_trip0>;
				cooling-device = <&ctf2301 0 50>;
			};

			map1 {
				trip = <&thermal4_top_trip1>;
				cooling-device = <&ctf2301 64 75>;
			};

			map2 {
				trip = <&thermal4_top_trip2>;
				cooling-device = <&ctf2301 102 128>;
			};

			map3 {
				trip = <&thermal4_top_trip3>;
				cooling-device = <&ctf2301 179 204>;
			};

			map4 {
				trip = <&thermal4_top_trip4>;
				cooling-device = <&ctf2301 255 255>;
			};
		};
	};

	thermal_5 {
		polling-delay = <1000>;
		polling-delay-passive = <250>;
		thermal-sensors = <&thermal 5>;

		trips {
			thermal5_trip0: thermal5-trip0 {
				temperature = <40000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};
	};

	thermal_6 {
		polling-delay = <1000>;
		polling-delay-passive = <250>;
		thermal-sensors = <&thermal 6>;

		trips {
			thermal6_trip0: thermal6-trip0 {
				temperature = <40000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};
	};

	thermal_7 {
		polling-delay = <1000>;
		polling-delay-passive = <250>;
		thermal-sensors = <&thermal 7>;

		trips {
			thermal7_trip0: thermal7-trip0 {
				temperature = <40000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};
	};
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_0_cfg>;
	status = "okay";

	tcpc@25 {
		compatible = "onsemi,fusb301";
		reg = <0x25>;
		pinctrl-names = "default";
		pinctrl-0 = <&fusb301_cfg>;
		irq-gpios = <&gpio 1 26 GPIO_ACTIVE_LOW>;
		wakeup-source;
		status = "okay";

		typec_0: connector@0 {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "sink";
			typec-power-opmode = "default";
			pd-disable;

			ports {
				#address-cells = <0x1>;
				#size-cells = <0x0>;

				port@0 {
					reg = <0x0>;
					fusb301_ep: endpoint {
						remote-endpoint = <&porta_role_switch>;
					};
				};

				port@1 {
					reg = <0x1>;
					fusb301_sw_ep: endpoint {
						remote-endpoint = <&usb3_phy_switch>;
					};
				};
			};
		};
	};
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_1_cfg>;
	status = "okay";

	eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		read-only;
		status = "okay";

		nvmem-layout {
			compatible = "onie,tlv-layout";

			product_name: product-name {
			};
		};
	};
};

&i2c6 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_1_cfg>;
	status = "okay";

	ctf2301: ctf2301@4c {
		compatible = "sensylink,ctf2301";
		reg = <0x4c>;
		#cooling-cells = <2>;
	};
};

&flexcan2 {
	clock-frequency = <80000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&can2_1_cfg>;
	status = "okay";
};

/*
