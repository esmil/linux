/{
	soc: soc {
		#address-cells = <2>;
		#size-cells = <2>;

		encoder0: encoder@d9002000 {
			compatible = "riscv,trace-encoder";
			reg = <0x0 0xd9002000 0x0 0x1000>;
			cpus = <&cpu_0>;
			out-ports {
				port {
					cluster0_encoder0_out_port: endpoint {
						remote-endpoint = <&cluster0_bridge0_in_port>;
					};
				};
			};
		};

		bridge0: bridge@d9003000 {
