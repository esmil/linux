					};
				};
			};
			in-ports {
				port {
					etf_in_port: endpoint {
						remote-endpoint = <&main_funnel_out_port>;
					};
				};
			};
		};

		etr: etr@d9044000 {
			compatible = "arm,coresight-tmc", "arm,primecell";
			reg = <0x0 0xd9044000 0x0 0x1000>;
			clocks = <&dummy_clk>;
			clock-names = "apb_pclk";
			arm,scatter-gather;
			in-ports {
				port {
					etr_in_port: endpoint {
						remote-endpoint = <&etf_out_port>;
					};
				};
			};
		};
