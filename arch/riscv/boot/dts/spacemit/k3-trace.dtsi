		etf: etf@d9043000 {
			compatible = "arm,coresight-tmc", "arm,primecell";
			reg = <0x0 0xd9043000 0x0 0x1000>;
			clocks = <&dummy_clk>;
			clock-names = "apb_pclk";
			out-ports {
