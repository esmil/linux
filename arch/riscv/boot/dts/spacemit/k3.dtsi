/dts-v1/;

#include "k3-cpus.dtsi"
#include <dt-bindings/reset/spacemit-k3-reset.h>

/ {
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial0 = &uart0;
	};

	chosen {
		bootargs = "earlycon=sbi console=ttyS0,115200 clk_ignore_unused nohlt loglevel=8 initcall_debug=1 memblock=debug";
		stdout-path = "serial0:115200";
	};

	memory@102000000 {
		device_type = "memory";
		reg = <0x1 0x02000000 0x0 0x7e000000>;
	};

	dummy_clk: apb-pclk {
		compatible = "fixed-clock";
		#clock-cells = <0x0>;
		clock-output-names = "clk14mhz";
		clock-frequency = <14000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* used for rcpu0 code & data & bss space */
		rcpu0_pwr: rcpu0_pwr@100200000 {
			reg = <0x1 0x200000 0x0 0x300000>;
			no-map;
		};

		/* rcpu0's heap */
		rcpu0_heap: rcpu0_heap@100500000 {
			reg = <0x1 0x500000 0x0 0x200000>;
			no-map;
		};

		/* vring0 */
		rcpu0_vdev0vring0: vdev0vring0@c0876000 {
			reg = <0x0 0xc0876000 0x0 0x3000>;
			no-map;
		};

		/* vring1 */
		rcpu0_vdev0vring1: vdev0vring1@c0879000 {
			reg = <0x0 0xc0879000 0x0 0x3000>;
			no-map;
		};

		/* rcpu0's dtb */
		rcpu0_dtb: rcpu0_dtb@c087c000 {
			reg = <0x0 0xc087c000 0x0 0x4000>;
			no-map;
		};

		/* the rcpu0's share memory buffer */
		rcpu0_vdev0buffer: vdev0buffer@100700000 {
			compatible = "shared-dma-pool";
			reg = <0x1 0x700000 0x0 0xfc000>;
			no-map;
		};

		/* the rcpu0's resource table */
		rcpu0_rsc_table: rcpu0_rsc_table@1007fc000 {
			reg = <0x1 0x7fc000 0x0 0x4000>;
			no-map;
		};

		/* rpmi */
		rpmi0: rpmi0@100800000 {
			reg = <0x1 0x00800000 0x0 0x4000>;
			no-map;
		};

		/*****************rcpu1**********************/
		/* used for rcp1 code & data & bss space */
		rcpu1_runtime: rcpu1_runtime@100804000 {
			reg = <0x1 0x804000 0x0 0x300000>;
			no-map;
		};

		/* rcpu1's heap */
		rcpu1_heap: rcpu1_heap@100B04000 {
			reg = <0x1 0xb04000 0x0 0x200000>;
			no-map;
		};

		/* vring0 */
		rcpu1_vdev0vring0: vdev0vring0@c086c000 {
			reg = <0x0 0xc086c000 0x0 0x3000>;
			no-map;
		};

		/* vring1 */
		rcpu1_vdev0vring1: vdev0vring1@c086f000 {
			reg = <0x0 0xc086f000 0x0 0x3000>;
			no-map;
		};

		/* rcpu1's dtb */
		rcpu1_dtb: rcpu1_dtb@c0872000 {
			reg = <0x0 0xc0872000 0x0 0x4000>;
			no-map;
		};

		/* the rcpu1's share memory buffer */
		rcpu1_vdev0buffer: vdev0buffer@100d04000 {
			compatible = "shared-dma-pool";
			reg = <0x1 0xd04000 0x0 0xfc000>;
			no-map;
		};

		/* the rcpu1's resource table */
		rcpu1_rsc_table: rcpu1_rsc_table@100e00000 {
			reg = <0x1 0xe00000 0x0 0x4000>;
			no-map;
		};
	};

	soc: soc {
		#address-cells = <2>;
		#size-cells = <2>;
		compatible = "simple-bus";
		dma-noncoherent;
		ranges;

		clint0: clint@e081c000 {
			compatible = "riscv,clint0";
			interrupts-extended = <
				&cpu0_intc  3 &cpu0_intc  7
				&cpu1_intc  3 &cpu1_intc  7
				&cpu2_intc  3 &cpu2_intc  7
				&cpu3_intc  3 &cpu3_intc  7
				&cpu4_intc  3 &cpu4_intc  7
				&cpu5_intc  3 &cpu5_intc  7
				&cpu6_intc  3 &cpu6_intc  7
				&cpu7_intc  3 &cpu7_intc  7
				&cpu8_intc  3 &cpu8_intc  7
				&cpu9_intc  3 &cpu9_intc  7
				&cpu10_intc  3 &cpu10_intc  7
				&cpu11_intc  3 &cpu11_intc  7
				&cpu12_intc  3 &cpu12_intc  7
				&cpu13_intc  3 &cpu13_intc  7
				&cpu14_intc  3 &cpu14_intc  7
				&cpu15_intc  3 &cpu15_intc  7
			>;
			reg = <0x0 0xe081c000 0x0 0x0004000>;
			clint,has-no-64bit-mmio;
		};

		simsic: interrupt-controller@e0400000 {
			compatible = "riscv,imsics";
			interrupts-extended = <
				&cpu0_intc 9 &cpu1_intc 9
				&cpu2_intc 9 &cpu3_intc 9
				&cpu4_intc 9 &cpu5_intc 9
				&cpu6_intc 9 &cpu7_intc 9
				&cpu8_intc 9 &cpu9_intc 9
				&cpu10_intc 9 &cpu11_intc 9
				&cpu12_intc 9 &cpu13_intc 9
				&cpu14_intc 9 &cpu15_intc 9>;

			reg = <0x0 0xe0400000 0x0 0x40000
				0x0 0xe0440000 0x0 0x40000
				0x0 0xe0480000 0x0 0x40000
				0x0 0xe04c0000 0x0 0x40000
				0x0 0xe0500000 0x0 0x40000
				0x0 0xe0540000 0x0 0x40000
				0x0 0xe0580000 0x0 0x40000
				0x0 0xe05c0000 0x0 0x40000
				0x0 0xe0600000 0x0 0x40000
				0x0 0xe0640000 0x0 0x40000
				0x0 0xe0680000 0x0 0x40000
				0x0 0xe06c0000 0x0 0x40000
				0x0 0xe0700000 0x0 0x40000
				0x0 0xe0740000 0x0 0x40000
				0x0 0xe0780000 0x0 0x40000
				0x0 0xe07c0000 0x0 0x40000>;
			interrupt-controller;
			#interrupt-cells = <0>;
			#msi-cells = <0>;
			msi-controller;
			/* Number of interrupt identities: 511 */
			riscv,num-ids = <511>;
			/* Number of guest interrupt identities: 511 */
			riscv,num-guest-ids = <511>;
			/* Number of HART index bits: 4 (2^4 = 16 harts) */
			riscv,hart-index-bits = <4>;
			/*
			 * Number of guest index bits: 6
			 *    2^6 = 64 interrupt files
			 *        = 1 s-level interrupt file + 63 vs-level interrupt files
			 *
			 * But on K3,
			 *   X100: only 7 of the 63 vs-level interrupt files are valid.
			 *   A100: no valid vs-level interrupt files.
			 */
			riscv,guest-index-bits = <6>;
			status = "okay";
		};

		saplic: interrupt-controller@e0804000 {
			compatible = "riscv,aplic";
			/* aplic config */
			reg = <0x0 0xe0804000 0x0 0x4000>;
			msi-parent = <&simsic>;
			#interrupt-cells = <2>;
			interrupt-controller;
			/* the number of wired interrupt sources:512 */
			riscv,num-sources = <512>;
			status = "okay";
		};

		syscon_gpio: syscon-gpio{
			compatible = "syscon";
			reg = <0x0 0xd4019000 0x0 0x800>;
		};

		syscon_gpio_edge: syscon-gpio-edge{
			compatible = "syscon";
			reg = <0x0 0xd4019800 0x0 0x10>;
		};

		reset: reset-controller@d4050000 {
			compatible = "spacemit,k3-reset";
			reg = <0x0 0xd4050000 0x0 0x209c>,
			      <0x0 0xd4282800 0x0 0x400>,
			      <0x0 0xd4015000 0x0 0x1000>,
			      <0x0 0xd4090000 0x0 0x1000>,
			      <0x0 0xd4282c00 0x0 0x400>,
			      <0x0 0xd8440000 0x0 0x98>,
			      <0x0 0xc0000000 0x0 0x4280>,
			      <0x0 0xf0610000 0x0 0x20>,
			      <0x0 0xc0880000 0x0 0xd100>;
			reg-names = "mpmu", "apmu", "apbc", "apbs", "ciu",
				    "dciu", "ddrc", "apbc2", "rcpu";
			#reset-cells = <1>;
			status = "okay";
		};

		pinctrl: pinctrl@d401e000 {
			compatible = "spacemit,k3-pinctrl";
			reg = <0x0 0xd401e000 0x0 0x400>;
			syscon = <&syscon_gpio>;
			syscon-edge = <&syscon_gpio_edge>;
		};

		pdma0: pdma@d4000000 {
			compatible = "spacemit,pdma-1.0";
			reg = <0x0 0xd4000000 0x0 0x4000>;
			interrupt-parent = <&saplic>;
			interrupts = <72 4>;
			#dma-cells= <2>;
			#dma-channels = <32>;
			max-burst-size = <64>;
			status = "ok";
		};

		uart0: serial@d4017000 {
			compatible = "spacemit,pxa-uart";
			reg = <0x0 0xd4017000 0x0 0x100>;
			interrupt-parent = <&saplic>;
			interrupts = <42 4>;
			clk-fpga = <14750000>;
			dmas = <&pdma0 4 1
				&pdma0 3 1>;
			dma-names = "rx", "tx";
			status = "ok";
		};

		pwm0: pwm@d401a000 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd401a000 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm1: pwm@d401a400 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd401a400 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm2: pwm@d401a800 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd401a800 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm3: pwm@d401ac00 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd401ac00 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm4: pwm@d401b000 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd401b000 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm5: pwm@d401b400 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd401b400 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm6: pwm@d401b800 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd401b800 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm7: pwm@d401bc00 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd401bc00 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm8: pwm@d4020000 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd4020000 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm9: pwm@d4020400 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd4020400 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm10: pwm@d4020800 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd4020800 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm11: pwm@d4020c00 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd4020c00 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm12: pwm@d4021000 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd4021000 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm13: pwm@d4021400 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd4021400 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm14: pwm@d4021800 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd4021800 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm15: pwm@d4021c00 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd4021c00 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm16: pwm@d4022000 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd4022000 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm17: pwm@d4022400 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd4022400 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm18: pwm@d4022800 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd4022800 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		pwm19: pwm@d4022c00 {
			compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
			reg = <0x0 0xd4022c00 0x0 0x10>;
			#pwm-cells = <3>;
			k1,pwm-disable-fd;
			status = "disabled";
		};

		qspi: spi@d420c000 {
			compatible = "spacemit,k3-qspi";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x0 0xd420c000 0x0 0x1000>,
			      <0x0 0xb8000000 0x0 0xc00000>;
			reg-names = "qspi-base", "qspi-mmap";
			spacemit,qspi-sfa1ad = <0x4000000>;
			spacemit,qspi-sfa2ad = <0x100000>;
			spacemit,qspi-sfb1ad = <0x100000>;
			spacemit,qspi-sfb2ad = <0x100000>;
			spacemit,qspi-pmuap-reg = <0xd4282860>;
			spacemit,qspi-mpmu-acgr-reg = <0xd4051024>;
			spacemit,qspi-ahb-enable = <0>;
			spacemit,qspi-freq = <26500000>;
			spacemit,qspi-id = <4>;
			interrupts = <117 4>;
			interrupt-parent = <&saplic>;
			spacemit,qspi-tx-dma = <1>;
			spacemit,qspi-rx-dma = <1>;
			dmas = <&pdma0 45 1>;
			dma-names = "tx-dma";
			status = "disabled";
		};

		mailbox0: mailbox0@cac90000 {
			compatible = "spacemit,k3-mailbox";
			reg = <0x0 0xcac90000 0x0 0x400>;
			interrupt-parent = <&saplic>;
			interrupts = <210 4>;
			#mbox-cells = <1>;
			status = "okay";
		};

		mailbox1: mailbox1@cac90400 {
			compatible = "spacemit,k3-mailbox";
			reg = <0x0 0xcac90400 0x0 0x400>;
			interrupt-parent = <&saplic>;
			interrupts = <212 4>;
			#mbox-cells = <1>;
			status = "okay";
		};

		mailbox2: mailbox2@cac90800 {
			compatible = "spacemit,k3-mailbox";
			reg = <0x0 0xcac90800 0x0 0x400>;
			interrupt-parent = <&saplic>;
			interrupts = <214 4>;
			#mbox-cells = <1>;
			status = "okay";
		};

		mailbox3: mailbox3@cac90c00 {
			compatible = "spacemit,k3-mailbox";
			reg = <0x0 0xcac90c00 0x0 0x400>;
			interrupt-parent = <&saplic>;
			interrupts = <216 4>;
			#mbox-cells = <1>;
			status = "okay";
		};

		mailbox4: mailbox4@cac91000 {
			compatible = "spacemit,k3-mailbox";
			reg = <0x0 0xcac91000 0x0 0x400>;
			interrupt-parent = <&saplic>;
			interrupts = <217 4>;
			#mbox-cells = <1>;
			status = "okay";
		};

		mailbox5: mailbox5@cac91400 {
			compatible = "spacemit,k3-mailbox";
			reg = <0x0 0xcac91400 0x0 0x400>;
			interrupt-parent = <&saplic>;
			interrupts = <226 4>;
			#mbox-cells = <1>;
			status = "okay";
		};

		mailbox6: mailbox6@cac91800 {
			compatible = "spacemit,k3-mailbox";
			reg = <0x0 0xcac91800 0x0 0x400>;
			interrupt-parent = <&saplic>;
			interrupts = <227 4>;
			#mbox-cells = <1>;
			status = "okay";
		};

		rcpu0: rcpu_rproc0@0 {
			compatible = "spacemit,k3-rproc";
			reg =  <0 0 0 0>;
			mboxes = <&mailbox3 1>, <&mailbox3 2>;
			mbox-names = "vq0", "vq1";
			firmware-name = "k3_rcpu0_esos.elf";
			memory-region = <&rcpu0_pwr>, <&rcpu0_heap>, <&rcpu0_vdev0vring0>, <&rcpu0_vdev0buffer>,
					<&rcpu0_vdev0vring1>, <&rcpu0_rsc_table>;
			status = "disabled";
		};


		rcpu1: rcpu_rproc1@1 {
			compatible = "spacemit,k3-rproc";
			reg =  <0 0 0 0>;
			mboxes = <&mailbox4 0>, <&mailbox4 1>;
			mbox-names = "vq0", "vq1";
			firmware-name = "k3_rcpu1_esos.elf";
			memory-region = <&rcpu1_runtime>, <&rcpu1_heap>, <&rcpu1_vdev0vring0>, <&rcpu1_vdev0buffer>,
					<&rcpu1_vdev0vring1>, <&rcpu1_rsc_table>;
			status = "disabled";
		};

		timer0: timer@d4014000 {
			compatible = "spacemit,soc-timer";
			reg = <0x0 0xd4014000 0x0 0xc8>;
			spacemit,timer-id = <0>;
			spacemit,timer-fastclk-frequency = <3250000>;
			spacemit,timer-apb-frequency = <52000000>;
			spacemit,timer-frequency = <32768>;
			resets = <&reset RESET_TIMERS1>;
			status = "okay";

			counter0 {
				compatible = "spacemit,timer-match";
				interrupts = <23 4>;
				interrupt-parent = <&saplic>;
				spacemit,timer-broadcast;
				spacemit,timer-counter-id = <0>;
				status = "okay";
                        };
                };

		rtc: rtc@d4010000 {
			compatible = "mrvl,mmp-rtc";
			reg = <0x0 0xd4010000 0x0 0x100>;
			interrupt-parent = <&saplic>;
			interrupts = <21 4>, <22 4>;
			interrupt-names = "rtc 1Hz", "rtc alarm";
			clocks = <&ccu CLK_RTC>;
			resets = <&reset RESET_RTC>;
			status = "disabled";
		};

		tcm: tcm@00000000 {
			compatible = "spacemit,k1-tcm";
			reg = <0x0 0 0x0 0x4000000>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0x0 0 0x4000000>;
			no-memory-wc;
			/* the first range 0x00000~0x180000 */
			cluster0_tcm@0 {
				reg = <0x00000 0x60000>;
				cpus = <&cpu_8>, <&cpu_9>;
				pool;
			};
			cluster0_tcm@60000 {
				reg = <0x60000 0x60000>;
				cpus = <&cpu_8>, <&cpu_9>;
				pool;
			};
			cluster0_tcm@c0000 {
				reg = <0xc0000 0x60000>;
				cpus = <&cpu_10>, <&cpu_11>;
				pool;
			};
			cluster0_tcm@120000 {
				reg = <0x120000 0x60000>;
				cpus = <&cpu_10>, <&cpu_11>;
				pool;
			};

			/* the second range 0x2000000~0x2180000 */
			cluster1_tcm@2000000 {
				reg = <0x2000000 0x60000>;
				cpus = <&cpu_12>, <&cpu_13>;
				pool;
			};
			cluster1_tcm@2060000 {
				reg = <0x2060000 0x60000>;
				cpus = <&cpu_12>, <&cpu_13>;
				pool;
			};
			cluster1_tcm@20c0000 {
				reg = <0x20c0000 0x60000>;
				cpus = <&cpu_14>, <&cpu_15>;
				pool;
			};
			cluster1_tcm@2120000 {
				reg = <0x2120000 0x60000>;
				cpus = <&cpu_14>, <&cpu_15>;
				pool;
			};
		};
	};
};

