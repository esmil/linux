		qspi: spi@d420c000 {
			compatible = "spacemit,k3-qspi";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x0 0xd420c000 0x0 0x1000>,
			      <0x0 0xb8000000 0x0 0xc00000>;
			reg-names = "qspi-base", "qspi-mmap";
			spacemit,qspi-sfa1ad = <0x4000000>;
			spacemit,qspi-sfa2ad = <0x100000>;
			spacemit,qspi-sfb1ad = <0x100000>;
			spacemit,qspi-sfb2ad = <0x100000>;
			spacemit,qspi-pmuap-reg = <0xd4282860>;
			spacemit,qspi-mpmu-acgr-reg = <0xd4051024>;
			spacemit,qspi-ahb-enable = <0>;
			spacemit,qspi-freq = <26500000>;
			spacemit,qspi-id = <4>;
			interrupts = <117 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-parent = <&saplic>;
			spacemit,qspi-tx-dma = <1>;
			spacemit,qspi-rx-dma = <1>;
			dmas = <&pdma 45>;
			dma-names = "tx-dma";
			status = "disabled";
		};

