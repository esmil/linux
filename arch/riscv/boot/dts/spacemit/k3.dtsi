		rcpu0: rcpu_rproc0@0 {
			compatible = "spacemit,k3-rproc";
			reg =  <0 0 0 0>;
			mboxes = <&mailbox3 1>, <&mailbox3 2>;
			mbox-names = "vq0", "vq1";
			firmware-name = "k3_rcpu0_esos.elf";
			memory-region = <&rcpu0_pwr>, <&rcpu0_heap>, <&rcpu0_vdev0vring0>, <&rcpu0_vdev0buffer>,
					<&rcpu0_vdev0vring1>, <&rcpu0_rsc_table>;
			status = "disabled";
		};

		rcpu1: rcpu_rproc1@1 {
			compatible = "spacemit,k3-rproc";
			reg =  <0 0 0 0>;
			mboxes = <&mailbox4 0>, <&mailbox4 1>;
			mbox-names = "vq0", "vq1";
			firmware-name = "k3_rcpu1_esos.elf";
			memory-region = <&rcpu1_runtime>, <&rcpu1_heap>, <&rcpu1_vdev0vring0>, <&rcpu1_vdev0buffer>,
					<&rcpu1_vdev0vring1>, <&rcpu1_rsc_table>;
			status = "disabled";
