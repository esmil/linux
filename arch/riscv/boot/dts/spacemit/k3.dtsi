		mpxy_mbox: mpxy_mbox@0 {
			compatible = "riscv,sbi-mpxy-mbox";
			#mbox-cells = <2>;
			status = "disabled";
		};

		rpmi_regulator: rpmi_regulator@0 {
			compatible = "riscv,rpmi-regulator";
			mboxes = <&mpxy_mbox 0x0007 0x0>;
			status = "okay";
		};

		rpmi_rtc: rpmi_rtc@0 {
			compatible = "riscv,rpmi-rtc";
			mboxes = <&mpxy_mbox 0xe 0x0>;
			interrupt-parent = <&saplic>;
			interrupts = <64 4>;
			interrupt-names = "rpmi rtc";
			status = "disabled";
		};

		rpmi_pwrkey: rpmi_pwrkey@0 {
			compatible = "riscv,rpmi-pwrkey";
			mboxes = <&mpxy_mbox 0xf 0x0>;
			interrupt-parent = <&saplic>;
			interrupts = <64 4>;
			interrupt-names = "rpmi pwrkey";
			status = "disabled";
		};

		pmu: power-management@0 {
			compatible = "simple-bus";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;

			power: power-controller {
				compatible = "spacemit,power-controller";
				mboxes = <&mpxy_mbox 0x9 0x0>;
				#power-domain-cells = <1>;
				#address-cells = <1>;
				#size-cells = <0>;
				spacemit,mpmu = <&syscon_mpmu>;
			};
		};

		timer0: timer@d4014000 {
			compatible = "spacemit,soc-timer";
			reg = <0x0 0xd4014000 0x0 0xc8>;
			spacemit,timer-id = <0>;
			spacemit,timer-fastclk-frequency = <3250000>;
			spacemit,timer-apb-frequency = <52000000>;
			spacemit,timer-frequency = <32768>;
			resets = <&syscon_apbc RESET_APBC_TIMERS1>;
			status = "okay";

			counter0 {
				compatible = "spacemit,timer-match";
				interrupts = <23 IRQ_TYPE_LEVEL_HIGH>;
				interrupt-parent = <&saplic>;
				spacemit,timer-broadcast;
				spacemit,timer-counter-id = <0>;
				status = "okay";
			};
		};

		rtc: rtc@d4010000 {
			compatible = "mrvl,mmp-rtc";
			reg = <0x0 0xd4010000 0x0 0x100>;
			interrupt-parent = <&saplic>;
			interrupts = <21 IRQ_TYPE_LEVEL_HIGH>, <22 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "rtc 1Hz", "rtc alarm";
			resets = <&syscon_apbc RESET_APBC_RTC>;
			status = "disabled";
		};

