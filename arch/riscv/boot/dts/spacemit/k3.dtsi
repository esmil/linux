			reg = <0x0 0xd4017e00 0x0 0x100>;
			interrupts = <20 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-parent = <&saplic>;
			resets = <&syscon_apbc RESET_APBC_IR0>;
			clock-frequency = <102400000>;
			status = "disabled";
		};

		ircrx1: irc-rx1@d4017f00 {
			compatible = "spacemit-k1,irc";
			reg = <0x0 0xd4017f00 0x0 0x100>;
			interrupts = <69 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-parent = <&saplic>;
			resets = <&syscon_apbc RESET_APBC_IR1>;
			clock-frequency = <102400000>;
			status = "disabled";
		};

		tcm: tcm@00000000 {
			compatible = "spacemit,k1-tcm";
			reg = <0x0 0 0x0 0x4000000>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0x0 0 0x4000000>;
			no-memory-wc;
			/* the first range 0x00000~0x180000 */
			cluster0_tcm@0 {
				reg = <0x00000 0x60000>;
				cpus = <&cpu_8>, <&cpu_9>;
				pool;
			};
			cluster0_tcm@60000 {
				reg = <0x60000 0x60000>;
				cpus = <&cpu_8>, <&cpu_9>;
				pool;
			};
			cluster0_tcm@c0000 {
				reg = <0xc0000 0x60000>;
				cpus = <&cpu_10>, <&cpu_11>;
				pool;
			};
			cluster0_tcm@120000 {
				reg = <0x120000 0x60000>;
				cpus = <&cpu_10>, <&cpu_11>;
				pool;
			};

			/* the second range 0x2000000~0x2180000 */
			cluster1_tcm@2000000 {
				reg = <0x2000000 0x60000>;
				cpus = <&cpu_12>, <&cpu_13>;
				pool;
			};
			cluster1_tcm@2060000 {
				reg = <0x2060000 0x60000>;
				cpus = <&cpu_12>, <&cpu_13>;
				pool;
			};
			cluster1_tcm@20c0000 {
				reg = <0x20c0000 0x60000>;
				cpus = <&cpu_14>, <&cpu_15>;
				pool;
			};
			cluster1_tcm@2120000 {
				reg = <0x2120000 0x60000>;
				cpus = <&cpu_14>, <&cpu_15>;
				pool;
			};
		};

		usb2_host: usb2@c0a00000 {
			compatible = "spacemit,k1-dwc3";
			reg = <0x0 0xc0a00000 0x0 0x10000>;
			interrupts = <105 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-parent = <&saplic>;
			clocks = <&syscon_apmu CLK_APMU_USB2_BUS>;
			resets = <&syscon_apmu RESET_APMU_USB2>;
			maximum-speed = "high-speed";
			status = "disabled";
		};

		usb3_porta: usb3@cad00000 {
			compatible = "spacemit,k1-dwc3";
			reg = <0x0 0xcad00000 0x0 0x10000>;
			interrupts = <118 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-parent = <&saplic>;
			clocks = <&syscon_apmu CLK_APMU_USB3_PORTA_BUS>;
			resets = <&syscon_apmu RESET_APMU_USB3_PORTA>;
			status = "disabled";
		};

		usb3_portb: usb3@815f0000 {
			compatible = "spacemit,k1-dwc3";
			reg = <0x0 0x815f0000 0x0 0x10000>;
			interrupts = <125 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-parent = <&saplic>;
			clocks = <&syscon_apmu CLK_APMU_USB3_PORTB_BUS>;
			resets = <&syscon_apmu RESET_APMU_USB3_PORTB>;
			status = "disabled";
		};

		usb3_portc: usb3@818f0000 {
			compatible = "spacemit,k1-dwc3";
			reg = <0x0 0x818f0000 0x0 0x10000>;
			interrupts = <148 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-parent = <&saplic>;
			clocks = <&syscon_apmu CLK_APMU_USB3_PORTC_BUS>;
			resets = <&syscon_apmu RESET_APMU_USB3_PORTC>;
			status = "disabled";
		};

		usb3_portd: usb3@81bf0000 {
			compatible = "spacemit,k1-dwc3";
			reg = <0x0 0x81bf0000 0x0 0x10000>;
			interrupts = <149 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-parent = <&saplic>;
			clocks = <&syscon_apmu CLK_APMU_USB3_PORTD_BUS>;
			resets = <&syscon_apmu RESET_APMU_USB3_PORTD>;
			status = "disabled";
		};

		gmac_axi_setup: stmmac-axi-config {
			snps,wr_osr_lmt = <0xf>;
			snps,rd_osr_lmt = <0xf>;
			/* max axi burst len is 256 */
			snps,blen = <256 128 64 32 16 0 0>;
		};

		eth0: ethernet@cac80000 {
			compatible = "spacemit,k3-gmac", "snps,dwmac-5.10a";
			reg = <0x0 0xcac80000 0x0 0x2000>;
			spacemit,apmu = <&syscon_apmu>;
			spacemit,ctrl-offset = <0x3e4>;
			spacemit,dline-offset = <0x3e8>;
			clocks = <&syscon_apmu CLK_APMU_EMAC0_BUS>,
				 <&syscon_apmu CLK_APMU_EMAC0_1588>;
			clock-names = "stmmaceth", "ptp_ref";
			resets = <&syscon_apmu RESET_APMU_EMAC0>;
			reset-names = "stmmaceth";
			interrupt-parent = <&saplic>;
			interrupts = <131 4>, <276 4>;
			interrupt-names = "macirq", "eth_wake_irq";
			mac-address = [00 00 00 00 00 00];
			snps,axi-config = <&gmac_axi_setup>;
			status = "disabled";
		};

		eth1: ethernet@cac82000 {
			compatible = "spacemit,k3-gmac", "snps,dwmac-5.10a";
			reg = <0x0 0xcac82000 0x0 0x2000>;
			spacemit,apmu = <&syscon_apmu>;
			spacemit,ctrl-offset = <0x3ec>;
			spacemit,dline-offset = <0x3f0>;
			clocks = <&syscon_apmu CLK_APMU_EMAC1_BUS>,
				 <&syscon_apmu CLK_APMU_EMAC1_1588>;
			clock-names = "stmmaceth", "ptp_ref";
			resets = <&syscon_apmu RESET_APMU_EMAC1>;
			reset-names = "stmmaceth";
			interrupt-parent = <&saplic>;
			interrupts = <133 4>, <277 4>;
			interrupt-names = "macirq", "eth_wake_irq";
			mac-address = [00 00 00 00 00 00];
			snps,axi-config = <&gmac_axi_setup>;
			status = "disabled";
		};

		eth2: ethernet@cac8e000 {
			compatible = "spacemit,k3-gmac", "snps,dwmac-5.10a";
			reg = <0x0 0xcac8e000 0x0 0x2000>;
			spacemit,apmu = <&syscon_apmu>;
			spacemit,ctrl-offset = <0x248>;
			spacemit,dline-offset = <0x24c>;
			clocks = <&syscon_apmu CLK_APMU_EMAC2_BUS>,
				 <&syscon_apmu CLK_APMU_EMAC2_1588>;
			clock-names = "stmmaceth", "ptp_ref";
			resets = <&syscon_apmu RESET_APMU_EMAC2>;
			reset-names = "stmmaceth";
			interrupt-parent = <&saplic>;
			interrupts = <130 4>, <278 4>;
			interrupt-names = "macirq", "eth_wake_irq";
			mac-address = [00 00 00 00 00 00];
			snps,axi-config = <&gmac_axi_setup>;
			status = "disabled";
		};

		eth3: ethernet@a0000000 {
			compatible = "spacemit,k3-gmac", "snps,dwmac-5.10a";
			reg = <0x0 0xa0000000 0x0 0x2000>;
			spacemit,apmu = <&syscon_rcpu_sysctrl>;
			spacemit,ctrl-offset = <0x0e4>;
			spacemit,dline-offset = <0x0e8>;
			clocks = <&syscon_rcpu_sysctrl CLK_RCPU_SYSCTRL_REMAC_BUS>,
				 <&syscon_rcpu_sysctrl CLK_RCPU_SYSCTRL_REMAC_1588>;
			clock-names = "stmmaceth", "ptp_ref";
			resets = <&syscon_rcpu_sysctrl RESET_RCPU_SYSCTRL_RGMAC>;
			reset-names = "stmmaceth";
			interrupt-parent = <&saplic>;
			interrupts = <237 4>, <236 4>;
			interrupt-names = "macirq", "eth_wake_irq";
			mac-address = [00 00 00 00 00 00];
			snps,axi-config = <&gmac_axi_setup>;
			status = "disabled";
		};

		sdcard: mmc@d4280000 {
			compatible = "spacemit,k3-sdhci";
			reg = <0x0 0xd4280000 0x0 0x200>;
			clocks = <&syscon_apmu CLK_APMU_SDH_AXI>,
				 <&syscon_apmu CLK_APMU_SDH0>,
				 <&syscon_apbc CLK_APBC_AIB_BUS>,
				 <&syscon_apbc CLK_APBC_AIB>;
			clock-names = "core", "io", "aib-bus", "aib";
			interrupt-parent = <&saplic>;
			interrupts = <99 IRQ_TYPE_LEVEL_HIGH>;
			resets = <&syscon_apmu RESET_APMU_SDH_AXI>,
				 <&syscon_apmu RESET_APMU_SDH0>;
			reset-names = "sdh_axi", "sdh0";
			status = "disabled";
		};

		sdio: mmc@d4280800 {
			compatible = "spacemit,k3-sdhci";
			reg = <0x0 0xd4280800 0x0 0x200>;
			clocks = <&syscon_apmu CLK_APMU_SDH_AXI>,
				 <&syscon_apmu CLK_APMU_SDH1>;
			clock-names = "core", "io";
			interrupt-parent = <&saplic>;
			interrupts = <100 IRQ_TYPE_LEVEL_HIGH>;
			resets = <&syscon_apmu RESET_APMU_SDH_AXI>,
				 <&syscon_apmu RESET_APMU_SDH1>;
			reset-names = "sdh_axi", "sdh1";
			status = "disabled";
		};

		emmc: mmc@d4281000 {
			compatible = "spacemit,k3-sdhci";
			reg = <0x0 0xd4281000 0x0 0x200>;
			clocks = <&syscon_apmu CLK_APMU_SDH_AXI>,
				 <&syscon_apmu CLK_APMU_SDH2>;
			clock-names = "core", "io";
			interrupt-parent = <&saplic>;
			interrupts = <101 IRQ_TYPE_LEVEL_HIGH>;
			resets = <&syscon_apmu RESET_APMU_SDH_AXI>,
				 <&syscon_apmu RESET_APMU_SDH2>;
			reset-names = "sdh_axi", "sdh2";
			status = "disabled";
		};
	};
};
