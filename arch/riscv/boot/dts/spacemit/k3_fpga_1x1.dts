#include "k3.dtsi"

/ {
	compatible = "spacemit,k3-fpga";
	cpus: cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <10000000>;
	};
};

&uart0 {
		status = "okay";
};

&qspi {
	status = "disabled";
};

&usb3_porta {
	status = "disabled";
	maximum-speed = "high-speed";
	dr_mode = "peripheral";
	phy_type = "utmi_wide";
	snps,dis_u2_susphy_quirk;
	snps,dis_enblslpm_quirk;
};
