	r_flexcan4: fdcan@c0750000 {
		compatible = "spacemit,k1-flexcan";
		reg = <0x0 0xc0750000 0x0 0x4000>;
		clocks = <&syscon_rcpu_sysctrl CLK_RCPU_SYSCTRL_RCAN4>,
