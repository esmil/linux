		#pwm-cells = <3>;
		k1,pwm-disable-fd;
		status = "disabled";
	};

	rpwm3: pwm@c088d400 {
		compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
		reg = <0x0 0xc088d400 0x0 0x10>;
		clocks = <&syscon_rcpu_pwmctrl CLK_RCPU_PWMCTRL_RPWM3>,
			 <&syscon_rcpu_pwmctrl CLK_RCPU_PWMCTRL_RPWM3_BUS>;
		clock-names = "func", "bus";
		resets = <&syscon_rcpu_pwmctrl RESET_RCPU_PWMCTRL_PWM3>;
		#pwm-cells = <3>;
		k1,pwm-disable-fd;
		status = "disabled";
	};

	rpwm4: pwm@c088d500 {
