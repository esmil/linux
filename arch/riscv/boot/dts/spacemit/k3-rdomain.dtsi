		resets = <&syscon_rcpu_sysctrl RESET_RCPU_SYSCTRL_RCAN2>;
		status = "disabled";
	};

	r_flexcan3: fdcan@c0740000 {
		compatible = "spacemit,k1-flexcan";
		reg = <0x0 0xc0740000 0x0 0x4000>;
		clocks = <&syscon_rcpu_sysctrl CLK_RCPU_SYSCTRL_RCAN3>,
			 <&syscon_rcpu_sysctrl CLK_RCPU_SYSCTRL_RCAN3_BUS>;
		clock-names = "per","ipg";
		interrupts = <247 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-parent = <&saplic>;
		fsl,clk-source = <0>;
		resets = <&syscon_rcpu_sysctrl RESET_RCPU_SYSCTRL_RCAN3>;
		status = "disabled";
	};

	r_flexcan4: fdcan@c0750000 {
		compatible = "spacemit,k1-flexcan";
		reg = <0x0 0xc0750000 0x0 0x4000>;
		clocks = <&syscon_rcpu_sysctrl CLK_RCPU_SYSCTRL_RCAN4>,
			 <&syscon_rcpu_sysctrl CLK_RCPU_SYSCTRL_RCAN4_BUS>;
		clock-names = "per","ipg";
		interrupts = <249 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-parent = <&saplic>;
		fsl,clk-source = <0>;
		resets = <&syscon_rcpu_sysctrl RESET_RCPU_SYSCTRL_RCAN4>;
		status = "disabled";
	};

	rpwm0: pwm@c088d100 {
		compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
		reg = <0x0 0xc088d100 0x0 0x10>;
		clocks = <&syscon_rcpu_pwmctrl CLK_RCPU_PWMCTRL_RPWM0>,
			 <&syscon_rcpu_pwmctrl CLK_RCPU_PWMCTRL_RPWM0_BUS>;
		clock-names = "func", "bus";
		resets = <&syscon_rcpu_pwmctrl RESET_RCPU_PWMCTRL_PWM0>;
		#pwm-cells = <3>;
		k1,pwm-disable-fd;
		status = "disabled";
	};

	rpwm1: pwm@c088d200 {
		compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
		reg = <0x0 0xc088d200 0x0 0x10>;
		clocks = <&syscon_rcpu_pwmctrl CLK_RCPU_PWMCTRL_RPWM1>,
			 <&syscon_rcpu_pwmctrl CLK_RCPU_PWMCTRL_RPWM1_BUS>;
		clock-names = "func", "bus";
		resets = <&syscon_rcpu_pwmctrl RESET_RCPU_PWMCTRL_PWM1>;
		#pwm-cells = <3>;
		k1,pwm-disable-fd;
		status = "disabled";
	};

	rpwm2: pwm@c088d300 {
		compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
		reg = <0x0 0xc088d300 0x0 0x10>;
		clocks = <&syscon_rcpu_pwmctrl CLK_RCPU_PWMCTRL_RPWM2>,
