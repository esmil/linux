	rpwm9: pwm@c088da00 {
		compatible = "spacemit,k1-pwm", "marvell,pxa910-pwm";
		reg = <0x0 0xc088da00 0x0 0x10>;
		clocks = <&syscon_rcpu_pwmctrl CLK_RCPU_PWMCTRL_RPWM9>,
