	};

	r_i2c0: ri2c@c0886000 {
		compatible = "spacemit,k1-i2c";
		reg = <0x0 0xc0886000 0x0 0x38>;
		#address-cells = <1>;
		#size-cells = <0>;
		interrupt-parent = <&saplic>;
		interrupts = <272 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&syscon_rcpu_i2cctrl CLK_RCPU_I2CCTRL_RI2C0>,
			 <&syscon_rcpu_i2cctrl CLK_RCPU_I2CCTRL_RI2C0_BUS>;
		clock-names = "func", "bus";
		clock-frequency = <400000>;
		resets = <&syscon_rcpu_i2cctrl RESET_RCPU_I2CCTRL_RI2C0>;
		status = "disabled";
	};

	r_i2c1: ri2c@c0886100 {
		compatible = "spacemit,k1-i2c";
		reg = <0x0 0xc0886100 0x0 0x38>;
		#address-cells = <1>;
		#size-cells = <0>;
		interrupt-parent = <&saplic>;
		interrupts = <273 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&syscon_rcpu_i2cctrl CLK_RCPU_I2CCTRL_RI2C1>,
			 <&syscon_rcpu_i2cctrl CLK_RCPU_I2CCTRL_RI2C1_BUS>;
		clock-names = "func", "bus";
		clock-frequency = <400000>;
		resets = <&syscon_rcpu_i2cctrl RESET_RCPU_I2CCTRL_RI2C1>;
		status = "disabled";
	};

	adma0: adma0@C0883000 {
		compatible = "spacemit,k3-adma";
		reg = <0x0 0xc0883000 0x0 0x100>,
		      <0x0 0xc08d0000 0x0 0x100>;
		reg-names = "adma_reg", "buf_addr";
		interrupt-parent = <&saplic>;
		interrupts = <257 IRQ_TYPE_LEVEL_HIGH>,
			     <258 IRQ_TYPE_LEVEL_HIGH>;
		#dma-cells= <1>;
		#dma-channels = <2>;
		status = "disabled";
	};

	adma1: adma1@C0883400 {
		compatible = "spacemit,k3-adma";
		reg = <0x0 0xc0883400 0x0 0x100>,
		      <0x0 0xc08d0100 0x0 0x100>;
		reg-names = "adma_reg", "buf_addr";
		interrupt-parent = <&saplic>;
		interrupts = <260 IRQ_TYPE_LEVEL_HIGH>,
			     <261 IRQ_TYPE_LEVEL_HIGH>;
		#dma-cells= <1>;
		#dma-channels = <2>;
		status = "disabled";
	};

	adma2: adma2@C0883800 {
		compatible = "spacemit,k3-adma";
		reg = <0x0 0xc0883800 0x0 0x100>,
		      <0x0 0xc08d0200 0x0 0x100>;
		reg-names = "adma_reg", "buf_addr";
		interrupt-parent = <&saplic>;
		interrupts = <263 IRQ_TYPE_LEVEL_HIGH>,
			     <264 IRQ_TYPE_LEVEL_HIGH>;
		#dma-cells= <1>;
		#dma-channels = <2>;
		status = "disabled";
	};

	adma3: adma3@C0883C00 {
		compatible = "spacemit,k3-adma";
		reg = <0x0 0xc0883C00 0x0 0x100>,
		      <0x0 0xc08d0300 0x0 0x100>;
		reg-names = "adma_reg", "buf_addr";
		interrupt-parent = <&saplic>;
		interrupts = <266 IRQ_TYPE_LEVEL_HIGH>,
			     <267 IRQ_TYPE_LEVEL_HIGH>;
		#dma-cells= <1>;
		#dma-channels = <2>;
		status = "disabled";
	};

	ri2s0: ri2s0@c0883100 {
		compatible = "spacemit,k3-ri2s";
		#sound-dai-cells = <0>;
		reg = <0x0 0xc0883100 0x0 0x300>,
		      <0x0 0xc08d0400 0x0 0x4000>;
		clocks = <&syscon_rcpu_i2sctrl CLK_RCPU_I2SCTRL_RI2S0>,
			 <&syscon_rcpu_i2sctrl CLK_RCPU_I2SCTRL_RI2S0_BUS>,
			 <&syscon_rcpu_sysctrl CLK_RCPU_SYSCTRL_RI2S0_SYSCLK>;
		clock-names = "func", "bus", "sysclk";
		resets = <&syscon_rcpu_i2sctrl RESET_RCPU_I2SCTRL_RI2S0>,
			 <&syscon_rcpu_sysctrl RESET_RCPU_SYSCTRL_RI2S0_SYSCLK>;
		reset-names = "reset", "reset-sys";
		dmas = <&adma0 1>, <&adma0 0>;
		dma-names = "rx", "tx";
		status = "disabled";
	};

	ri2s1: ri2s1@c0883500 {
		compatible = "spacemit,k3-ri2s";
		#sound-dai-cells = <0>;
		reg = <0x0 0xc0883500 0x0 0x300>,
		      <0x0 0xc08d4400 0x0 0x4000>;
		clocks = <&syscon_rcpu_i2sctrl CLK_RCPU_I2SCTRL_RI2S1>,
			 <&syscon_rcpu_i2sctrl CLK_RCPU_I2SCTRL_RI2S1_BUS>,
			 <&syscon_rcpu_sysctrl CLK_RCPU_SYSCTRL_RI2S1_SYSCLK>;
		clock-names = "func", "bus", "sysclk";
		resets = <&syscon_rcpu_i2sctrl RESET_RCPU_I2SCTRL_RI2S1>,
			 <&syscon_rcpu_sysctrl RESET_RCPU_SYSCTRL_RI2S1_SYSCLK>;
		reset-names = "reset", "reset-sys";
		dmas = <&adma1 1>, <&adma1 0>;
		dma-names = "rx", "tx";
		status = "disabled";
	};

	ri2s2: ri2s2@c0883900 {
		compatible = "spacemit,k3-ri2s";
		#sound-dai-cells = <0>;
		reg = <0x0 0xc0883500 0x0 0x300>,
		      <0x0 0xc08d8400 0x0 0x4000>;
		clocks = <&syscon_rcpu_i2sctrl CLK_RCPU_I2SCTRL_RI2S2>,
			 <&syscon_rcpu_i2sctrl CLK_RCPU_I2SCTRL_RI2S2_BUS>,
			 <&syscon_rcpu_i2sctrl CLK_RCPU_I2SCTRL_RI2S2_SYSCLK>;
		clock-names = "func", "bus", "sysclk";
		resets = <&syscon_rcpu_i2sctrl RESET_RCPU_I2SCTRL_RI2S2>,
			 <&syscon_rcpu_i2sctrl RESET_RCPU_I2SCTRL_RI2S2_SYSCLK>;
		reset-names = "reset", "reset-sys";
		dmas = <&adma2 1>, <&adma2 0>;
		dma-names = "rx", "tx";
		status = "disabled";
	};

	ri2s3: ri2s1@c0883D00 {
		compatible = "spacemit,k3-ri2s";
		#sound-dai-cells = <0>;
		reg = <0x0 0xc0883500 0x0 0x300>,
		      <0x0 0xc08dc400 0x0 0x4000>;
		clocks = <&syscon_rcpu_i2sctrl CLK_RCPU_I2SCTRL_RI2S3>,
			 <&syscon_rcpu_i2sctrl CLK_RCPU_I2SCTRL_RI2S3_BUS>,
			 <&syscon_rcpu_i2sctrl CLK_RCPU_I2SCTRL_RI2S3_SYSCLK>;
		clock-names = "func", "bus", "sysclk";
		resets = <&syscon_rcpu_i2sctrl RESET_RCPU_I2SCTRL_RI2S3>,
			 <&syscon_rcpu_i2sctrl RESET_RCPU_I2SCTRL_RI2S3_SYSCLK>;
		reset-names = "reset", "reset-sys";
		dmas = <&adma3 1>, <&adma3 0>;
		dma-names = "rx", "tx";
		status = "disabled";
	};
};
