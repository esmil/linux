&cpus {
	clst_core_opp_table0_x100: opp_table0_x100 {
		compatible = "operating-points-v2";
		opp-shared;

		clocks = <&pll CLK_PLL3>, <&pll CLK_PLL4>;
		clock-names = "pll_clst0", "pll_clst1";

		opp2400000000 {
			opp-hz = /bits/ 64 <2400000000>, /bits/ 64 <2400000000>;
			opp-microvolt = <1000000>;
			clock-latency-ns = <200000>;
		};

		opp2200000000 {
			opp-hz = /bits/ 64 <2200000000>, /bits/ 64 <2200000000>;
			opp-microvolt = <880000>;
			clock-latency-ns = <200000>;
		};

		opp2000000000 {
			opp-hz = /bits/ 64 <2000000000>, /bits/ 64 <2000000000>;
			opp-microvolt = <880000>;
			clock-latency-ns = <200000>;
		};

		opp1500000000 {
			opp-hz = /bits/ 64 <1500000000>, /bits/ 64 <1500000000>;
			opp-microvolt = <850000>;
			clock-latency-ns = <200000>;
		};

		opp1228000000 {
			opp-hz = /bits/ 64 <1228000000>, /bits/ 64 <1228000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <200000>;
		};

		opp1000000000 {
			opp-hz = /bits/ 64 <1000000000>, /bits/ 64 <1000000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <200000>;
		};

		opp819000000 {
			opp-hz = /bits/ 64 <819200000>, /bits/ 64 <819200000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <200000>;
		};

		opp614500000 {
			opp-hz = /bits/ 64 <614500000>, /bits/ 64 <614500000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <200000>;
		};
	};

	clst_core_opp_table0_a100: opp_table0_a100 {
		compatible = "operating-points-v2";
		opp-shared;

		opp2000000000 {
			opp-hz = /bits/ 64 <2000000000>, /bits/ 64 <2000000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <200000>;
		};

		opp1500000000 {
			opp-hz = /bits/ 64 <1500000000>, /bits/ 64 <1500000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <200000>;
		};

		opp1228000000 {
			opp-hz = /bits/ 64 <1228000000>, /bits/ 64 <1228000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <200000>;
		};

		opp1000000000 {
			opp-hz = /bits/ 64 <1000000000>, /bits/ 64 <1000000000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <200000>;
		};

		opp819000000 {
			opp-hz = /bits/ 64 <819200000>, /bits/ 64 <819200000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <200000>;
		};

		opp614500000 {
			opp-hz = /bits/ 64 <614500000>, /bits/ 64 <614500000>;
			opp-microvolt = <800000>;
			clock-latency-ns = <200000>;
		};
	};
};

&cpu_0 {
	clst-supply = <&edcdc1>;
	clocks = <&syscon_apmu CLK_APMU_CPU_C0_CORE>, <&syscon_apmu CLK_APMU_CPU_C1_CORE>;
	clock-names = "cls0", "cls1";
	operating-points-v2 = <&clst_core_opp_table0_x100>;
};

&cpu_1 {
	clst-supply = <&edcdc1>;
	clocks = <&syscon_apmu CLK_APMU_CPU_C0_CORE>, <&syscon_apmu CLK_APMU_CPU_C1_CORE>;
	clock-names = "cls0", "cls1";
	operating-points-v2 = <&clst_core_opp_table0_x100>;
